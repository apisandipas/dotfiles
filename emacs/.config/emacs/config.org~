* Basic UI Configuration

#+begin_src emacs-lisp
       (defvar bp/frame-transparency '(90 . 90))  
       (setq inhibit-startup-message t)

       (scroll-bar-mode -1)        ; Disable visible scrollbar
       (tool-bar-mode -1)          ; Disable the toolbar
       (tooltip-mode -1)           ; Disable tooltips
       (set-fringe-mode 10)        ; Give some breathing room

       (menu-bar-mode -1)            ; Disable the menu bar

       ;; Set up the visible bell
       (setq visible-bell t)

       (column-number-mode)
       (global-display-line-numbers-mode t)

       ;; Set frame transparency

       (set-frame-parameter (selected-frame) 'alpha bp/frame-transparency)
       (add-to-list 'default-frame-alist `(alpha . ,bp/frame-transparency))
       (set-frame-parameter nil 'alpha-background 90)
       (add-to-list 'default-frame-alist '(alpha-background . 90))
       (set-frame-parameter (selected-frame) 'fullscreen 'maximized)
       (add-to-list 'default-frame-alist '(fullscreen . maximized))

       ;; Disable line numbers for some modes
       (dolist (mode '(org-mode-hook
		       term-mode-hook
		       shell-mode-hook
		       treemacs-mode-hook
		       eshell-mode-hook))
	 (add-hook mode (lambda () (display-line-numbers-mode 0))))


    (defun bp/make-frame-pretty ()
    "Set the initial look and feel of the frame."
    (modify-all-frames-parameters
     '((right-divider-width . 24)
       (mouse-color . "white")
       (internal-border-width . 24))))

  (add-hook 'before-make-frame-hook 'bp/make-frame-pretty)

  (setq default-frame-alist '((vertical-scroll-bars . nil)
                            (internal-border-width . 24)
                            (left-fringe . 0)
                            (right-fringe . 0)
                            (alpha-background . 80)
                            (tool-bar-lines . 0)
                            (menu-bar-lines . 0)))

